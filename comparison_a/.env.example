# Copy to .env; never commit actual credentials.
RAVE_API_KEY=
RAVE_BASE_URL=https://api.openai.com/v1
RAVE_MODEL=gpt-4.1-mini
RAVE_SEARCH_MODEL=gpt-5-search-api
RAVE_SEARCH_CONTEXT_SIZE=low
RAVE_SEARCH_MAX_OUTPUT_TOKENS=512
RAVE_ANALYSIS_MAX_OUTPUT_TOKENS=8192
RAVE_SEARCH_INPUT_RESERVE_TOKENS=8192
RAVE_TIMEOUT_SECONDS=90

# REQUIRED: configure from the applicable OpenAI billing/pricing record.
# These are USD per 1 million tokens. No dedicated GPT-5 Search API token-rate
# row is published in the official pricing table; do not guess or copy a rate
# for another model unless you explicitly accept it as an estimate.
RAVE_SEARCH_INPUT_USD_PER_1M=1.25
RAVE_SEARCH_OUTPUT_USD_PER_1M=10.0
# Carried forward from the recorded pilot's user-configured rate schedule; verify against billing.

# Live runs require an explicit local ceiling <= USD 0.50 and an account/project
# spend limit in OpenAI Platform. Local estimates are not provider-side hard caps.
