# Copy to .env; never commit actual credentials.
RAVE_API_KEY=
RAVE_BASE_URL=https://api.openai.com/v1
RAVE_MODEL=gpt-4.1-mini
RAVE_SEARCH_MODEL=gpt-5-search-api
RAVE_SEARCH_CONTEXT_SIZE=low
RAVE_SEARCH_MAX_OUTPUT_TOKENS=512
RAVE_ANALYSIS_MAX_OUTPUT_TOKENS=4096
RAVE_SEARCH_INPUT_RESERVE_TOKENS=16384
RAVE_TIMEOUT_SECONDS=90

# Cost-control policy for the initial $10 API balance:
# Maximum allowed cost for one live run is enforced by the CLI: US$0.50.
# This is a local estimate/ceiling, not a provider-side billing hard cap.
# Keep account-level/project spend limits enabled in the OpenAI Platform.
