{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rave-benchmark-lab.local/contracts/run_metadata.schema.json",
  "title": "RunMetadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "request_id", "system_id", "started_at", "status", "calls", "sources_count", "errors", "stop_reason"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string"},
    "request_id": {"type": "string"},
    "system_id": {"type": "string"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"},
    "model_analysis": {"type": ["string", "null"]},
    "model_search": {"type": ["string", "null"]},
    "calls": {"type": "array", "items": {"type": "object", "required": ["kind", "status", "duration_seconds", "attempt"], "properties": {"kind": {"enum": ["analysis", "search", "page_read"]}, "status": {"enum": ["COMPLETED", "FAILED", "BLOCKED_BUDGET"]}, "duration_seconds": {"type": "number", "minimum": 0}, "attempt": {"type": "integer", "minimum": 1}, "input_tokens": {"type": ["integer", "null"], "minimum": 0}, "output_tokens": {"type": ["integer", "null"], "minimum": 0}, "cost_usd": {"type": ["number", "null"], "minimum": 0}}}},
    "tokens_input": {"type": "integer", "minimum": 0},
    "tokens_output": {"type": "integer", "minimum": 0},
    "tokens_total": {"type": "integer", "minimum": 0},
    "duration_seconds": {"type": "number", "minimum": 0},
    "cost_estimated_usd": {"type": ["number", "null"], "minimum": 0},
    "budget_remaining": {"type": "object"},
    "sources_count": {"type": "integer", "minimum": 0},
    "errors": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["COMPLETED", "PARTIAL", "INVALID", "FAILED"]},
    "stop_reason": {"type": ["string", "null"]}
  }
}
